<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="av"
             x:Class="UdemyKickerWPF.Controls.CourseCard"
             MinHeight="200" MaxWidth="800" HorizontalAlignment="Stretch">

    <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="HoverTranslate" X="0" Y="0"/>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverTranslate"
                                         Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverTranslate"
                                         Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: Image -->
            <Grid Margin="0,10,0,-1" HorizontalAlignment="Center" Width="268">
                <Border x:Name="myborder" BorderBrush="Black" CornerRadius="8" ClipToBounds="True" Height="150" VerticalAlignment="Center" Margin="0,0,10,0" Background="#FF131314">
                    <Image x:Name="imgThumbnail"  Stretch="UniformToFill" Source="https://via.placeholder.com/288x150" VerticalAlignment="Top" Margin="0,0,-6,0" HorizontalAlignment="Right"/>
                </Border>
                <Border Background="#4edea3" CornerRadius="4" Margin="10,22,213,134" Padding="8,4">
                    <TextBlock x:Name="lblQuality" Text="1080p" Foreground="#003824" FontSize="10" FontWeight="Bold"/>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="10,10,10,0" Height="54" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblTitle" Text="Course Title" Foreground="#e5e2e3" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="2" Margin="1,3,70,25"/>
                <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="1,31,70,6">
                    <ui:SymbolIcon Symbol="List24" Foreground="#baccb0" FontSize="16" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblInfo" Text="0 lectures" Foreground="#baccb0" FontSize="13" Margin="0,0,16,0"/>
                    <ui:SymbolIcon Symbol="Clock24" Foreground="#baccb0" FontSize="16" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblHours" Text="0 total hours" Foreground="#baccb0" FontSize="13"/>
                    <ui:SymbolIcon Symbol="Star24" Foreground="#FFD700" Margin="16,0,4,0" FontSize="16"/>
                    <TextBlock x:Name="lblRating" Text="4.7" Foreground="#e5e2e3" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1A4edea3" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                    <TextBlock x:Name="lblSpeedBadge" Text="0.0 MB/s" Foreground="#4edea3" FontSize="13" FontWeight="Bold"/>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="10,65,0,0" Grid.Column="1" Height="42" VerticalAlignment="Top" HorizontalAlignment="Left" Width="136">
                <Button x:Name="btnPlay" Width="40" Height="40" Background="#4edea3" BorderThickness="0" Margin="0,0,8,0" Click="BtnPlay_Click" Cursor="Hand" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon Symbol="Play24" Foreground="#003824"/>
                </Button>
                <Button x:Name="btnPause" Width="40" Height="40" Background="#1D2A22" BorderBrush="#4edea3" BorderThickness="1" Margin="0,0,8,0" Click="BtnPause_Click" Cursor="Hand" Padding="16,8" Foreground="#4EDEA3">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon Symbol="Pause24" Foreground="#4edea3"/>
                </Button>
                <Button x:Name="btnFolder" Width="40" Height="40" Background="#1D2A22" BorderBrush="#3c4a42" BorderThickness="1" Click="BtnFolder_Click" Cursor="Hand" Padding="16,8" Foreground="#4EDEA3">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon Symbol="Folder24" Foreground="#baccb0"/>
                </Button>
            </StackPanel>

            <ProgressBar x:Name="barVideoProgress" Height="10" Margin="10,116,10,54" Grid.Column="1" Background="#353436" Foreground="#4edea3" BorderThickness="0" Minimum="0" Maximum="100"/>
            <ProgressBar x:Name="barTotalProgress" Height="10" Margin="10,148,10,22" Grid.Column="1" Background="#353436" Foreground="#FFFFA303" BorderThickness="0" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="lblItemsText" Text=" " Foreground="#baccb0" FontSize="13" Grid.Column="1" Margin="105,168,176,0" RenderTransformOrigin="0.533,0.519"/>

            <!-- Keep existing elements as requested -->
            <Button x:Name="btnFolder_Copy" Width="97" Height="18" BorderThickness="0" Click="BtnFolder_Click" Margin="151,78,0,0" VerticalAlignment="Top" Grid.Column="1" Background="#FF134761" SnapsToDevicePixels="False" Cursor="No" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <ui:TextBlock Grid.Column="1" Margin="162,78,234,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FFB4A725">
                <Run Language="de-de" Text="current media:"/>
            </ui:TextBlock>
            <ui:TextBlock x:Name="cname" Grid.Column="1" Margin="253,79,22,0" TextWrapping="NoWrap" VerticalAlignment="Top" Foreground="#FF38EAB9" FontStretch="Normal" FontStyle="Normal" FontWeight="Bold" TextTrimming="WordEllipsis" FontFamily="Segoe UI Variable Text Light" Text=""/>

        </Grid>
    </Border>
</UserControl>