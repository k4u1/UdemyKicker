<ui:FluentWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="av" 
        x:Class="UdemyKickerWPF.Views.LoginWindow"
        Title="UdemyKicker - Login" Height="700" MinWidth="900" MaxWidth="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Loaded="Window_Loaded" 
        ResizeMode="CanResizeWithGrip" 
        Visibility="Visible" 
        RenderTransformOrigin="0.5,0.5">

    <ui:FluentWindow.Resources>
        <Style x:Key="BrowserLoginBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4EDEA3"/>
            <Setter Property="BorderBrush" Value="#4EDEA3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" SpreadMethod="Reflect" Opacity="1">
            <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                    <RotateTransform Angle="58" CenterY="0.5" CenterX="0.5"/>
                    <TranslateTransform/>
                </TransformGroup>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF06381B" Offset="1"/>
            <GradientStop Color="#FF0D1511" Offset="0.407"/>
        </LinearGradientBrush>
    </ui:FluentWindow.Background>

    <ui:FluentWindow.Effect>
        <DropShadowEffect/>
    </ui:FluentWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="UdemyKicker" Height="48" VerticalAlignment="Center" Grid.ColumnSpan="2"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="400" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Browser Discovery -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="24,24,12,24">
                <StackPanel x:Name="pnlManual" VerticalAlignment="Center" Margin="0,0,0,40">

                    <!-- Logo Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                        <Border Height="173" Width="219">
                            <Grid>
                                <Border x:Name="avatarBorder" CornerRadius="48" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="61,0,62,77">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#4edea3" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ui:SymbolIcon x:Name="iconAvatar" Symbol="Person24" FontSize="48" Foreground="#4edea3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="UdemyKicker" Foreground="#e5e2e3" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,112,0,18"/>
                                <TextBlock Text="Unified High-Speed Learning Utility" Foreground="#bbcabf" FontSize="14" HorizontalAlignment="Center" Opacity="0.7" Margin="0,155,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <!-- Header row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <ui:SymbolIcon Symbol="Globe24" Foreground="#4edea3" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DETECTED ACCOUNTS" Foreground="#4edea3" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Scanning indicator (shown while scanning) -->
                            <StackPanel x:Name="pnlScanning" Grid.Column="1" Orientation="Horizontal" Visibility="Visible">
                                <TextBlock x:Name="txtScanStatus" Text="Scanning browsers..." Foreground="#bbcabf" FontSize="11" FontFamily="Consolas" Opacity="0.7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Account buttons container -->
                        <StackPanel x:Name="pnlAccountButtons"/>

                        <!-- No accounts found message -->
                        <TextBlock x:Name="txtNoAccounts" Visibility="Collapsed" Text="No saved Udemy accounts found in your browsers." Foreground="#bbcabf" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Terminal Footer -->
                    <Grid Margin="0,32,0,0" Opacity="0.4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel: Manual Token Input -->
            <Border Grid.Column="1" Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="16" Margin="12,24,24,24" Padding="32" VerticalAlignment="Center" MaxWidth="480">
                <StackPanel Margin="0,0,0,0">
                    <!-- Token Field -->
                    <TextBlock Text="ACCESS TOKEN" Foreground="#9DB0A6" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,0,8"/>
                    <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Margin="0,0,0,24" Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Key24" Foreground="#9DB0A6" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <TextBox x:Name="txtToken" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" Width="300" Padding="0" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Tag="Enter Bearer token..."/>
                        </StackPanel>
                    </Border>

                    <!-- Action Button -->
                    <Button Content="INITIALIZE SESSION" Background="#4EDEA3" BorderThickness="0" Foreground="#0A1410" HorizontalAlignment="Stretch" Padding="16,16" FontSize="16" FontWeight="Bold" Margin="0,0,0,24" Click="BtnLogin_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Browser Link -->
                    <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#9DB0A6">
                        <Run Text="Don't have a token? "/>
                        <Run Text=" "/>
                        <Hyperlink Foreground="#4EDEA3" TextDecorations="None" FontWeight="SemiBold" Click="BtnBrowser_Click">
                            <Run Text="Login via Browser"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Browser Login Panel (initially hidden) -->
            <Grid x:Name="pnlBrowser" Visibility="Collapsed" Margin="24,24,24,24" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Content="Back" Grid.Row="0" Margin="0,0,0,16" Click="BtnBack_Click" Background="#1AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#9DB0A6" Padding="16,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <wv2:WebView2 x:Name="webView" Grid.Row="1" NavigationCompleted="WebView_NavigationCompleted"/>
            </Grid>

            <!-- Hidden WebView2 used ONLY for fetching user info via JS fetch() (same as SplashWindow) -->
            <wv2:WebView2 x:Name="webViewApi" Visibility="Collapsed" Margin="24"/>

            <!-- Dividers -->
            <Border Grid.Column="0" Height="1" Background="#2AFFFFFF" Margin="24,0,24,0" VerticalAlignment="Bottom" Grid.Row="1"/>
            <Border Grid.Column="1" Height="1" Background="#2AFFFFFF" Margin="24,0,24,0" VerticalAlignment="Bottom" Grid.Row="1"/>

        </Grid>
    </Grid>
</ui:FluentWindow>