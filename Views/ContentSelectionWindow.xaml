<ui:FluentWindow x:Class="UdemyKickerWPF.Views.ContentSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Select Content to Download" Height="650" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ShowInTaskbar="False">

    <ui:FluentWindow.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF0A2D1A" Offset="1"/>
        </LinearGradientBrush>
    </ui:FluentWindow.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title / Header -->
        <Grid Grid.Row="0" Margin="0,15,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Select Chapters &amp; Lessons" FontSize="20" FontWeight="Bold" Foreground="#4EDEA3" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Selected for Download: " Foreground="#9DB0A6" FontSize="13" />
                <TextBlock x:Name="lblSelectedCount" Text="0" Foreground="#4EDEA3" FontSize="14" FontWeight="Bold" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="lblCourseTitle" Text="Course Title" FontSize="12" Foreground="#9DB0A6" TextWrapping="Wrap" Margin="0,0,0,15" />

        <!-- Chapters List Scroll -->
        <Border Grid.Row="2" Background="#1AFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lstChapters">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,4" Background="#2A222222" BorderBrush="#2AFFFFFF" BorderThickness="1" IsExpanded="False" Foreground="#E0E0E0">
                                <Expander.Header>
                                    <Grid Width="420" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="ChapterCheckbox_Changed" Unchecked="ChapterCheckbox_Changed" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#E0E0E0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>
                                </Expander.Header>
                                <Expander.Content>
                                    <ItemsControl ItemsSource="{Binding Lectures}" Margin="20,4,8,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="LectureCheckbox_Changed" Unchecked="LectureCheckbox_Changed" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#9DB0A6" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <Border Grid.Column="2" Background="#1A4EDEA3" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Type}" Foreground="#4EDEA3" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer Control Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnToggleSelectAll" Content="Select All" Click="BtnToggleSelectAll_Click" Width="120" Background="Transparent" Foreground="#4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" Cursor="Hand" Padding="16,8">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnCancel" Content="Cancel" Click="BtnCancel_Click" Width="80" Margin="0,0,10,0" Background="Transparent" Foreground="#4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" Cursor="Hand" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="btnStart" Content="Start Download" Click="BtnStart_Click" Width="140" Background="#4EDEA3" Foreground="#0A1410" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
