<Page x:Class="UdemyKickerWPF.Views.PlayerView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

      xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"

      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

      Title="PlayerView" Loaded="Page_Loaded" Opacity="0">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Page.Resources>

        <Style x:Key="SidebarLecStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#9DB0A6"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="HorizontalAlignment" Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Padding" Value="10,8"/>

            <Setter Property="Margin" Value="0,2"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bgBorder" Property="Background" Value="#1A4EDEA3"/>

                                <Setter Property="Foreground" Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>



    <Grid>

        <!-- SCREEN 1: COURSE LIBRARY -->

        <Grid x:Name="LibraryGrid" Margin="24" Visibility="Visible">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>



            <!-- Library Header -->

            <Grid Grid.Row="0" Margin="0,0,0,24">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="320"/>

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Course Player" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold"/>

                    <TextBlock Text="Browse and learn from your offline downloaded courses." Foreground="#9DB0A6" FontSize="16" Margin="0,0,0,8"/>

                </StackPanel>



                <!-- Search box -->

                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="12" ClipToBounds="True">

                    <ui:TextBox x:Name="txtCourseSearch" PlaceholderText="Search downloaded courses..." Icon="Search24" Padding="10" FontSize="13" TextChanged="TxtCourseSearch_TextChanged" Background="#0A1410" BorderThickness="1" BorderBrush="#2AFFFFFF" Foreground="#FFFFFF"/>

                </Border>

            </Grid>



            <!-- Scrollable grid of courses -->

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <Grid>

                    <WrapPanel x:Name="wpLocalCourses" HorizontalAlignment="Stretch"/>

                    <TextBlock x:Name="lblNoLocalCourses" Text="No offline courses detected. Download a course first to start watching!" Foreground="#9DB0A6" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,64,0,0" Visibility="Collapsed"/>

                </Grid>

            </ScrollViewer>

        </Grid>



        <!-- SCREEN 2: COURSE CONTENT PLAYER -->

        <Grid x:Name="PlayerGrid" Visibility="Collapsed">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="280" MinWidth="240" MaxWidth="360"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- 1. Left Sidebar -->

            <Border Grid.Column="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" Background="#0A1410">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Back button and course title -->

                    <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="12,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="BtnBackToLibrary_Click" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,8,0" Cursor="Hand">

                                <ui:SymbolIcon Symbol="ChevronLeft24" Foreground="#4EDEA3" FontSize="20"/>

                            </Button>

                            <TextBlock Grid.Column="1" x:Name="lblActiveCourseTitle" Text="Course Name" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        </Grid>

                    </Border>



                    <!-- Progress bar -->

                    <Border Grid.Row="1" Padding="14,12" Background="#0A1410">

                        <StackPanel>

                            <Grid Margin="0,0,0,4">

                                <TextBlock Text="Progress" Foreground="#9DB0A6" FontSize="11" FontWeight="SemiBold"/>

                                <TextBlock x:Name="lblSidebarProgressText" Text="0/0 Lectures" Foreground="#4EDEA3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>

                            </Grid>

                            <ProgressBar x:Name="barSidebarProgress" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#4EDEA3" Background="#111" BorderThickness="0"/>

                        </StackPanel>

                    </Border>



                    <!-- Curriculum List -->

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="spCurriculum" Margin="8,8"/>

                    </ScrollViewer>



                    <!-- Sidebar Footer (Me button) -->

                    <Border Grid.Row="3" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="12,8">

                        <Button Click="BtnMe_Click" Padding="12,10" Background="#1A4EDEA3" Foreground="#9DB0A6" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bgBorder" Property="Background" Value="#1A4EDEA3"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid HorizontalAlignment="Stretch">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0" Symbol="Person24" Foreground="#4EDEA3" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1" Text="Me &amp; Progress (حسابي وتقاديمي)" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

                            </Grid>

                        </Button>

                    </Border>

                </Grid>

            </Border>



            <!-- 2. Right Content panel -->

            <Grid Grid.Column="1" Background="#0C1310">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <!-- Active Lecture Header -->

                <Border Grid.Row="0" Background="#0A1410" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="20,12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                            <ui:SymbolIcon x:Name="icoLectureType" Symbol="Play24" Foreground="#4EDEA3" Margin="0,0,10,0"/>

                            <TextBlock x:Name="lblActiveLectureTitle" Text="Select a lecture to play" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Mark Complete Button -->

                        <Button Grid.Column="1" x:Name="btnMarkComplete" Click="BtnMarkComplete_Click" Content="Mark Complete (تم المشاهدة)" Background="#1A4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" Foreground="#4EDEA3" FontWeight="Bold" Padding="14,6" Visibility="Collapsed" Cursor="Hand">

                            <Button.Resources>

                                <Style TargetType="Border">

                                    <Setter Property="CornerRadius" Value="6"/>

                                </Style>

                            </Button.Resources>

                        </Button>

                    </Grid>

                </Border>



                <!-- Dynamic Content Area -->

                <Grid Grid.Row="1">

                    <!-- PANEL A: VLC Video Viewer -->

                    <Grid x:Name="panelVideo" Visibility="Collapsed">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="180"/>

                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="Black">

                            <vlc:VideoView x:Name="vlcVideoView" Focusable="True" MouseDoubleClick="VlcVideoView_MouseDoubleClick"/>

                        </Border>



                        <!-- Custom Controls Bar -->

                        <Border Grid.Row="1" Background="#0C140E" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="16,10">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="btnVlcPlayPause" Click="BtnVlcPlayPause_Click" Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,8,0" Cursor="Hand">

                                    <ui:SymbolIcon x:Name="icoVlcPlay" Symbol="Play24" Foreground="#4EDEA3" FontSize="18"/>

                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">

                                    <Button Click="BtnVlcRewind_Click" Background="Transparent" BorderThickness="0" Padding="6" ToolTip="Go back 10s (Left Arrow)" Cursor="Hand">

                                        <ui:SymbolIcon Symbol="ArrowUndo24" Foreground="#9DB0A6" FontSize="16"/>

                                    </Button>

                                    <Button Click="BtnVlcForward_Click" Background="Transparent" BorderThickness="0" Padding="6" ToolTip="Skip 10s (Right Arrow)" Cursor="Hand">

                                        <ui:SymbolIcon Symbol="ArrowRedo24" Foreground="#9DB0A6" FontSize="16"/>

                                    </Button>

                                </StackPanel>



                                <Slider Grid.Column="2" x:Name="sliderVlcProgress" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" Background="#353436" Foreground="#4EDEA3" Focusable="False" PreviewMouseLeftButtonDown="SliderVlcProgress_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SliderVlcProgress_PreviewMouseLeftButtonUp" ValueChanged="SliderVlcProgress_ValueChanged"/>



                                <TextBlock Grid.Column="3" x:Name="lblVlcTime" Text="00:00 / 00:00" Foreground="#9DB0A6" FontSize="12" VerticalAlignment="Center" Margin="14,0"/>



                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,10,0">

                                    <ui:SymbolIcon Symbol="LocalLanguage24" Foreground="#6B7F75" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbVlcSubtitles" Width="100" Background="#111" Foreground="White" BorderBrush="#2AFFFFFF" BorderThickness="1" SelectionChanged="CmbVlcSubtitles_SelectionChanged"/>

                                </StackPanel>



                                <Button Grid.Column="5" Click="BtnVlcFullscreen_Click" Background="Transparent" BorderThickness="0" Padding="6" ToolTip="Fullscreen (F)" Cursor="Hand">

                                    <ui:SymbolIcon Symbol="FullScreenMaximize24" Foreground="#9DB0A6" FontSize="16"/>

                                </Button>

                            </Grid>

                        </Border>



                        <!-- Notes Panel -->

                        <Border Grid.Row="2" Background="#0A1410" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="320"/>

                                </Grid.ColumnDefinitions>



                                <!-- Left: Add Note Form -->

                                <Border Grid.Column="0" Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="*"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">

                                            <TextBlock Text="Add Note (إضافة ملاحظة)" Foreground="#9DB0A6" FontSize="12" FontWeight="SemiBold"/>

                                            <TextBlock x:Name="lblNoteTimestamp" Text="at 00:00" Foreground="#4EDEA3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>

                                        </Grid>



                                        <!-- Text formatting toolbar -->

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,6">

                                            <Button Click="BtnFormatBold_Click" ToolTip="Bold (عريض)" Background="Transparent" BorderThickness="0" Padding="6,2" Margin="0,0,4,0" Cursor="Hand">

                                                <TextBlock Text="B" FontWeight="Bold" Foreground="#4EDEA3" FontSize="12"/>

                                            </Button>

                                            <Button Click="BtnFormatItalic_Click" ToolTip="Italic (مائل)" Background="Transparent" BorderThickness="0" Padding="6,2" Margin="0,0,4,0" Cursor="Hand">

                                                <TextBlock Text="I" FontStyle="Italic" Foreground="#4EDEA3" FontSize="12"/>

                                            </Button>

                                            <Button Click="BtnFormatCode_Click" ToolTip="Code (شفرة برمجة)" Background="Transparent" BorderThickness="0" Padding="6,2" Margin="0,0,4,0" Cursor="Hand">

                                                <TextBlock Text="&lt;/&gt;" Foreground="#4EDEA3" FontSize="11"/>

                                            </Button>

                                        </StackPanel>



                                        <RichTextBox Grid.Row="2" x:Name="rtbNoteText" 

                                                     AcceptsReturn="True" AcceptsTab="False"

                                                     Background="#111" Foreground="White" 

                                                     BorderBrush="#2AFFFFFF" BorderThickness="1"

                                                     Padding="8" FontSize="12" 

                                                     VerticalAlignment="Stretch"

                                                     VerticalScrollBarVisibility="Auto"

                                                     SpellCheck.IsEnabled="False">

                                            <RichTextBox.Resources>

                                                <Style TargetType="Paragraph">

                                                    <Setter Property="Margin" Value="0"/>

                                                </Style>

                                            </RichTextBox.Resources>

                                        </RichTextBox>



                                        <Button Grid.Row="3" x:Name="btnSaveNote" Click="BtnSaveNote_Click" Content="Save Note at Current Time" HorizontalAlignment="Stretch" Margin="0,8,0,0" Background="#1A4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" Foreground="#4EDEA3" FontWeight="Bold" Padding="8,5" Cursor="Hand">

                                            <Button.Resources>

                                                <Style TargetType="Border">

                                                    <Setter Property="CornerRadius" Value="4"/>

                                                </Style>

                                            </Button.Resources>

                                        </Button>

                                    </Grid>

                                </Border>



                                <!-- Right: List of saved notes -->

                                <Border Grid.Column="1" BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0" Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="*"/>

                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Lecture Notes (ملاحظات الدرس)" Foreground="#9DB0A6" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                            <StackPanel x:Name="spLectureNotes"/>

                                        </ScrollViewer>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>



                    <!-- PANEL B: WebView2 Document/Article/Quiz Viewer -->

                    <Grid x:Name="panelWeb" Visibility="Collapsed">

                        <wv2:WebView2 x:Name="wvDocViewer"/>

                    </Grid>



                    <!-- PANEL C: ZIP File Archive Inspector -->

                    <Grid x:Name="panelZip" Visibility="Collapsed" Margin="24">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">

                            <TextBlock Text="ZIP Resource Attachment (ملف مرفق مضغوط)" Foreground="#4EDEA3" FontSize="16" FontWeight="Bold"/>

                            <TextBlock Text="You can browse the contents of this archive and extract individual files." Foreground="#9DB0A6" FontSize="12"/>

                        </StackPanel>

                        <Border Grid.Row="1" Background="#0A1410" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel x:Name="spZipContents" Margin="16"/>

                            </ScrollViewer>

                        </Border>

                    </Grid>



                    <!-- PANEL D: Choose a lecture default view -->

                    <Grid x:Name="panelDefault" Visibility="Visible" Margin="48">

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                            <Border Width="80" Height="80" CornerRadius="40" Background="#1A4EDEA3" BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="0,0,0,16">

                                <ui:SymbolIcon Symbol="PlayCircle24" Foreground="#4EDEA3" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="Offline Learning Mode" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                            <TextBlock Text="Select a chapter and lecture from the sidebar curriculum to start learning." Foreground="#9DB0A6" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Grid>

        </Grid>



        <!-- SCREEN 3: ME &amp; STATISTICS -->

        <Grid x:Name="MeGrid" Margin="24" Visibility="Collapsed">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>



            <!-- Header -->

            <Grid Grid.Row="0" Margin="0,0,0,24">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BtnBackFromMe_Click" Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,16,0" VerticalAlignment="Center" Cursor="Hand">

                    <ui:SymbolIcon Symbol="ArrowLeft24" Foreground="#4EDEA3" FontSize="24"/>

                </Button>

                <StackPanel Grid.Column="1">

                    <TextBlock Text="My Learning Profile (ملفي التعليمي)" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold"/>

                    <TextBlock Text="Track your completed courses and achievements." Foreground="#9DB0A6" FontSize="16"/>

                </StackPanel>

            </Grid>



            <!-- Profile Info -->

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="340"/>

                    </Grid.ColumnDefinitions>



                    <StackPanel Grid.Column="0" Margin="0,0,24,0">

                        <TextBlock Text="My Courses Progress" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <StackPanel x:Name="spMeCoursesProgress"/>

                    </StackPanel>



                    <!-- Circular Progress/Stats Panel -->

                    <Border Grid.Column="1" Background="#0A1410" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="24" VerticalAlignment="Top">

                        <StackPanel>

                            <TextBlock Text="Overall Completion" Foreground="#9DB0A6" FontSize="12" FontWeight="Bold" Margin="0,0,0,16" HorizontalAlignment="Center"/>



                            <!-- Dynamic Stats -->

                            <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">

                                        <TextBlock x:Name="lblMeStartedCount" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Started" Foreground="#6B7F75" FontSize="11" HorizontalAlignment="Center"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                                        <TextBlock x:Name="lblMeCompletedCount" Text="0" Foreground="#4EDEA3" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Completed" Foreground="#6B7F75" FontSize="11" HorizontalAlignment="Center"/>

                                    </StackPanel>

                                </Grid>

                            </Border>



                            <StackPanel Margin="0,8,0,0">

                                <Grid Margin="0,0,0,4">

                                    <TextBlock Text="Lectures Completed" Foreground="#6B7F75" FontSize="12"/>

                                    <TextBlock x:Name="lblMeTotalLecturesText" Text="0/0" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>

                                </Grid>

                                <ProgressBar x:Name="barMeOverallProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#4EDEA3" Background="#111" BorderThickness="0"/>

                                <TextBlock x:Name="lblMeOverallPct" Text="0% Completed" Foreground="#4EDEA3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</Page>