<Page x:Class="UdemyKickerWPF.Views.LibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      mc:Ignorable="av" 
      Title="LibraryView" Loaded="Page_Loaded" 
      Style="{StaticResource PageFadeInStyle}"
      av:DesignWidth="546.813">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Home" Foreground="{StaticResource BrushLegacyTextPrimary}" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Manage and download your acquired media library." Foreground="{StaticResource BrushLegacyTextSecondary}" FontSize="16" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,10,0" CornerRadius="12" ClipToBounds="True">
                    <ui:TextBox x:Name="txtSearch" PlaceholderText="Search your courses..." Icon="Search24" Padding="12,12" FontSize="14" TextChanged="TxtSearch_TextChanged" Background="{StaticResource BrushLegacyHeaderBackground}" BorderThickness="1" BorderBrush="{StaticResource BrushOutline}" Foreground="{StaticResource BrushLegacyTextPrimary}" Style="{StaticResource DefaultTextBoxStyle}"/>
                </Border>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.ScrollUnit="Pixel">
            <StackPanel>
                <ui:ProgressRing x:Name="loader" IsIndeterminate="True" Visibility="Collapsed" Margin="0,20,0,20" Foreground="{StaticResource BrushBrandPrimary}"/>
                <WrapPanel x:Name="wpCourses" HorizontalAlignment="Stretch"/>

                <Button x:Name="btnLoadMore" Content="Load More" HorizontalAlignment="Center" Margin="0,20,0,20" Visibility="Collapsed" Click="BtnLoadMore_Click" Background="{StaticResource BrushBrandPrimary}" Foreground="{StaticResource BrushBrandOnPrimary}" FontWeight="Bold" Padding="24,12" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>