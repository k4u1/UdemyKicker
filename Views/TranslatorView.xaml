<Page x:Class="UdemyKickerWPF.Views.TranslatorView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

      Title="TranslatorView" Loaded="Page_Loaded" Opacity="0">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>


    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- Header -->

        <StackPanel Grid.Row="0" Margin="0,0,0,24">

            <TextBlock Text="Smart Translator &amp; Diagnostics Engine" FontSize="28" FontWeight="Bold" Foreground="#4EDEA3">

                <TextBlock.Effect>

                    <DropShadowEffect Color="#4EDEA3" BlurRadius="8" ShadowDepth="0"/>

                </TextBlock.Effect>

            </TextBlock>

            <TextBlock Text="Analyze hardware performance and translate local SRT / VTT files offline" FontSize="14" Foreground="#9DB0A6" Margin="0,4,0,0"/>

        </StackPanel>



        <!-- Content Columns -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.2*"/>

                <ColumnDefinition Width="1.5*"/>

            </Grid.ColumnDefinitions>



            <!-- Column 0: Diagnostics Card -->

            <Border Grid.Column="0" Background="#1AFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Hardware Performance Diagnostics" FontSize="18" FontWeight="Bold" Foreground="#4EDEA3" Margin="0,0,0,16"/>



                        <!-- CPU Info -->

                        <Border Background="#0C1310" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">

                            <Border.Triggers>

                                <EventTrigger RoutedEvent="UIElement.MouseEnter">

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#804EDEA3" Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </EventTrigger>

                                <EventTrigger RoutedEvent="UIElement.MouseLeave">

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#204EDEA3" Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </EventTrigger>

                            </Border.Triggers>

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                    <ui:SymbolIcon Symbol="Board24" FontSize="18" Foreground="#4EDEA3" Margin="0,0,8,0"/>

                                    <TextBlock Text="Processor (CPU)" FontSize="14" FontWeight="Bold" Foreground="White"/>

                                </StackPanel>

                                <TextBlock x:Name="lblCpuName" Text="Loading CPU specs..." FontSize="13" Foreground="#9DB0A6" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Rating: " FontSize="12" Foreground="#9DB0A6"/>

                                    <TextBlock x:Name="lblCpuRating" Text="Evaluating..." FontSize="12" FontWeight="Bold" Foreground="#4EDEA3"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>



                        <!-- GPU Info -->

                        <Border Background="#0C1310" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">

                            <Border.Triggers>

                                <EventTrigger RoutedEvent="UIElement.MouseEnter">

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#804EDEA3" Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </EventTrigger>

                                <EventTrigger RoutedEvent="UIElement.MouseLeave">

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#204EDEA3" Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </EventTrigger>

                            </Border.Triggers>

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                    <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="#4EDEA3" Margin="0,0,8,0"/>

                                    <TextBlock Text="Graphics Card (GPU)" FontSize="14" FontWeight="Bold" Foreground="White"/>

                                </StackPanel>

                                <TextBlock x:Name="lblGpuName" Text="Loading GPU specs..." FontSize="13" Foreground="#9DB0A6" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                                    <TextBlock Text="CUDA Hardware Acceleration: " FontSize="12" Foreground="#9DB0A6"/>

                                    <TextBlock x:Name="lblCudaSupport" Text="Evaluating..." FontSize="12" FontWeight="Bold" Foreground="#4EDEA3"/>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Rating: " FontSize="12" Foreground="#9DB0A6"/>

                                    <TextBlock x:Name="lblGpuRating" Text="Evaluating..." FontSize="12" FontWeight="Bold" Foreground="#4EDEA3"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>



                        <!-- Translation Benchmark Info -->

                        <Border Background="#0C1310" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">

                            <Border.Triggers>

                                <EventTrigger RoutedEvent="UIElement.MouseEnter">

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#804EDEA3" Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </EventTrigger>

                                <EventTrigger RoutedEvent="UIElement.MouseLeave">

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#204EDEA3" Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </EventTrigger>

                            </Border.Triggers>

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                    <ui:SymbolIcon Symbol="Timer24" FontSize="18" Foreground="#4EDEA3" Margin="0,0,8,0"/>

                                    <TextBlock Text="Estimated Local Model Translation Speed" FontSize="14" FontWeight="Bold" Foreground="White"/>

                                </StackPanel>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Estimated single-sentence time:" FontSize="13" Foreground="#9DB0A6"/>

                                    <TextBlock x:Name="lblEstimatedTime" Grid.Column="1" Text="0.0 seconds" FontSize="13" FontWeight="Bold" Foreground="White"/>

                                </Grid>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Device Speed Index:" FontSize="13" Foreground="#9DB0A6"/>

                                    <TextBlock x:Name="lblSpeedIndex" Grid.Column="1" Text="100%" FontSize="13" FontWeight="Bold" Foreground="#4EDEA3"/>

                                </Grid>

                            </StackPanel>

                        </Border>



                        <!-- Notes/Instructions -->

                        <Border Background="#05FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">

                            <TextBlock Text="* Translation speed relies heavily on CUDA-capable NVIDIA GPUs. If unavailable, CPU translation mode is automatically selected and will take longer." 

                                       FontSize="11" Foreground="#9DB0A6" TextWrapping="Wrap" Opacity="0.8"/>

                        </Border>



                    </StackPanel>

                </ScrollViewer>

            </Border>



            <!-- Column 1: Subtitle Translator Card -->

            <Border Grid.Column="1" Background="#1AFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="12,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <TextBlock Grid.Row="0" Text="Local Subtitle File Translator" FontSize="18" FontWeight="Bold" Foreground="#4EDEA3" Margin="0,0,0,16"/>



                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <!-- Drag &amp; Drop Zone -->

                            <Grid x:Name="DropZone" Height="150" Background="#0C1310" Margin="0,0,0,16"

                                  AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" MouseLeftButtonDown="DropZone_Click" Cursor="Hand">

                                <Grid.Triggers>

                                    <EventTrigger RoutedEvent="UIElement.MouseEnter">

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <ColorAnimation Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="#144EDEA3" Duration="0:0:0.2"/>

                                                <ColorAnimation Storyboard.TargetName="DropZoneOutline" Storyboard.TargetProperty="Stroke.(SolidColorBrush.Color)" To="#804EDEA3" Duration="0:0:0.2"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="UIElement.MouseLeave">

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <ColorAnimation Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="#0C1310" Duration="0:0:0.2"/>

                                                <ColorAnimation Storyboard.TargetName="DropZoneOutline" Storyboard.TargetProperty="Stroke.(SolidColorBrush.Color)" To="#204EDEA3" Duration="0:0:0.2"/>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </EventTrigger>

                                </Grid.Triggers>

                                <Rectangle x:Name="DropZoneOutline" Stroke="#1AFFFFFF" StrokeThickness="1.5" StrokeDashArray="4 4" RadiusX="12" RadiusY="12"/>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="36" Foreground="#4EDEA3" HorizontalAlignment="Center"/>

                                    <TextBlock Text="Drag &amp; Drop SRT or VTT file here" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,4"/>

                                    <TextBlock Text="or click to browse files manually" FontSize="12" Foreground="#9DB0A6" HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Grid>



                            <!-- Selected File Panel (Visible only when file loaded) -->

                            <Border x:Name="FilePanel" Visibility="Collapsed" Background="#05FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">

                                <StackPanel>

                                    <Grid Margin="0,0,0,10">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="Document24" FontSize="20" Foreground="#4EDEA3" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                            <TextBlock x:Name="lblFileName" Text="file.srt" FontSize="13" FontWeight="Bold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock x:Name="lblFilePath" Text="C:\path\to\file.srt" FontSize="11" Foreground="#9DB0A6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Clear" Click="BtnClearFile_Click" Background="Transparent" Foreground="#FF4545" BorderThickness="0" Padding="8,4" VerticalAlignment="Center" Cursor="Hand"/>

                                    </Grid>



                                    <!-- Subtitle File Detailed Statistics -->

                                    <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto"/>

                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4,4,4">

                                                <TextBlock Text="File Format" FontSize="10" Foreground="#9DB0A6"/>

                                                <TextBlock x:Name="lblFileFormat" Text="Unknown" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>

                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,4,0,4">

                                                <TextBlock Text="File Size" FontSize="10" Foreground="#9DB0A6"/>

                                                <TextBlock x:Name="lblFileSize" Text="0 KB" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>

                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,4,0">

                                                <TextBlock Text="Total Subtitle Blocks" FontSize="10" Foreground="#9DB0A6"/>

                                                <TextBlock x:Name="lblFileCues" Text="0 blocks" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>

                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,4,0,0">

                                                <TextBlock Text="Est. Translation Time" FontSize="10" Foreground="#9DB0A6"/>

                                                <TextBlock x:Name="lblFileEstDuration" Text="~0s" FontSize="12" FontWeight="Bold" Foreground="#4EDEA3" Margin="0,2,0,0"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </StackPanel>

                            </Border>



                            <!-- Action Panel / Controls -->

                            <StackPanel Margin="0,0,0,12">

                                <!-- Target Hardware Device Selector -->

                                <StackPanel Margin="0,0,0,12">

                                    <TextBlock Text="Target Execution Hardware" FontSize="11" Foreground="#9DB0A6" Margin="0,0,0,4"/>

                                    <ComboBox x:Name="cmbTargetDevice" SelectedIndex="0" Height="32" SelectionChanged="CmbTargetDevice_SelectionChanged" Background="#0C1310" Foreground="#E0E0E0" BorderBrush="#2AFFFFFF" BorderThickness="1">

                                        <ComboBoxItem Content="CPU (Software Mode)"/>

                                    </ComboBox>

                                </StackPanel>



                                <!-- Target Language &amp; Method -->

                                <Grid Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,6,0">

                                        <TextBlock Text="Target Language" FontSize="11" Foreground="#9DB0A6" Margin="0,0,0,4"/>

                                        <ComboBox x:Name="cmbTargetLanguage" SelectedIndex="0" Height="32" Background="#0C1310" Foreground="#E0E0E0" BorderBrush="#2AFFFFFF" BorderThickness="1">

                                            <ComboBoxItem Content="Arabic (العربية)"/>

                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">

                                        <TextBlock Text="Translation Method" FontSize="11" Foreground="#9DB0A6" Margin="0,0,0,4"/>

                                        <ComboBox x:Name="cmbTranslateMethod" SelectedIndex="0" Height="32" SelectionChanged="CmbTranslateMethod_SelectionChanged" Background="#0C1310" Foreground="#E0E0E0" BorderBrush="#2AFFFFFF" BorderThickness="1">

                                            <ComboBoxItem Content="Local Offline Model"/>

                                            <ComboBoxItem Content="Online API (Google Translate)"/>

                                        </ComboBox>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>



                            <!-- Console Output terminal -->

                            <TextBlock Text="Translation Console Logs" FontSize="12" FontWeight="Bold" Foreground="#9DB0A6" Margin="0,0,0,6"/>

                            <Border CornerRadius="12" ClipToBounds="True">

                                <ui:TextBox x:Name="txtConsole" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" 

                                         Background="#FF050A07" BorderBrush="#1AFFFFFF" Foreground="#9DB0A6" FontFamily="Consolas" Padding="8" FontSize="11" Text="Ready to begin..."/>

                            </Border>



                        </StackPanel>

                    </ScrollViewer>



                    <!-- Bottom Bar (Progress &amp; Start Button) -->

                    <Border Grid.Row="2" BorderBrush="#1DFFFFFF" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">

                                <ProgressBar x:Name="pbProgress" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1AFFFFFF" Foreground="#4EDEA3" BorderThickness="0"/>

                                <TextBlock x:Name="lblProgressStatus" Text="Ready" FontSize="11" Foreground="#9DB0A6" Margin="0,4,0,0"/>

                            </StackPanel>

                            <Button x:Name="btnTranslate" Grid.Column="1" Content="Translate Now" Click="BtnTranslate_Click" 

                                    Background="#4EDEA3" Foreground="Black" FontWeight="Bold" Padding="24,12" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>

                    </Border>



                </Grid>

            </Border>



        </Grid>

    </Grid>

</Page>