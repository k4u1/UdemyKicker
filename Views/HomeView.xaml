<Page x:Class="UdemyKickerWPF.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="HomeView" Style="{StaticResource PageFadeInStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Active Downloads" Foreground="{StaticResource BrushLegacyTextPrimary}" FontSize="32" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Monitor and control your ongoing course downloads." Foreground="{StaticResource BrushLegacyTextSecondary}" FontSize="16"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Click="BtnPauseAll_Click" Content="Pause All" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="16,8">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pause24" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Click="BtnResumeAll_Click" Content="Resume Paused" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </Grid>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.ScrollUnit="Pixel">
            <StackPanel>
                <ui:ProgressRing x:Name="loader" IsIndeterminate="True" Visibility="Collapsed" Margin="0,20,0,20" Foreground="{StaticResource BrushBrandPrimary}"/>
                <WrapPanel x:Name="wpActiveDownloads" HorizontalAlignment="Stretch"/>

                <TextBlock x:Name="lblNoDownloads" Text="No active downloads right now." Foreground="{StaticResource BrushLegacyTextSecondary}" FontSize="16" HorizontalAlignment="Center" Margin="0,64,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>