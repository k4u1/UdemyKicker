<ui:FluentWindow x:Class="UdemyKickerWPF.Views.SubtitleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Select Subtitles" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ShowInTaskbar="False">

    <ui:FluentWindow.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF0A2D1A" Offset="1"/>
        </LinearGradientBrush>
    </ui:FluentWindow.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title / Header -->
        <TextBlock Grid.Row="0" Text="Select Subtitles to Download" FontSize="18" FontWeight="Bold" Foreground="#4EDEA3" Margin="0,15,0,5" />
        <TextBlock Grid.Row="1" x:Name="lblCourseTitle" Text="Course Title" FontSize="12" Foreground="#9DB0A6" TextWrapping="Wrap" Margin="0,0,0,15" />

        <!-- Subtitle List -->
        <Border Grid.Row="2" Background="#1AFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="chkSelectAll" Content="Select All" Foreground="#E0E0E0" FontWeight="SemiBold" Margin="0,0,0,10" Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstLanguages">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4" Checked="SubtitleCheckbox_Changed" Unchecked="SubtitleCheckbox_Changed" Foreground="#E0E0E0">
                                    <TextBlock>
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" Foreground="#E0E0E0"/>
                                        <Run Text="{Binding LatestLabel, Mode=OneWay}" Foreground="#4EDEA3" FontWeight="Bold"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Click="BtnCancel_Click" Width="80" Margin="0,0,10,0" Background="Transparent" Foreground="#4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" Cursor="Hand" Padding="16,8">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btnOk" Content="Start Download" Click="BtnOk_Click" Width="130" Background="#4EDEA3" Foreground="#0A1410" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Padding="16,8">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</ui:FluentWindow>