<Page x:Class="UdemyKickerWPF.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SettingsView" Loaded="Page_Loaded" Opacity="0">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Account Overview -->
                <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="96" Height="96" CornerRadius="48" BorderBrush="#4EDEA3" BorderThickness="2" Margin="0,0,24,0">
                            <Grid>
                                <ui:SymbolIcon x:Name="iconAvatar" Symbol="Person24" FontSize="48" Foreground="#4EDEA3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="imgAvatar" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblGreeting" Text="User Profile" FontSize="24" FontWeight="Bold" Foreground="#4EDEA3" Margin="0,0,0,4">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#4EDEA3" BlurRadius="8" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="lblEmail" Text="loading..." FontSize="13" Foreground="#9DB0A6" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1A4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="API_CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#4EDEA3"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="lblCourses" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4EDEA3" HorizontalAlignment="Center"/>
                                <TextBlock Text="COURSES" FontSize="10" FontWeight="Bold" Foreground="#9DB0A6" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="lblCompleted" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4EDEA3" HorizontalAlignment="Center"/>
                                <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#9DB0A6" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Configuration Panels -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <ui:SymbolIcon Symbol="Video24" FontSize="20" Foreground="#4EDEA3" Margin="0,0,12,0"/>
                                    <TextBlock Text="DOWNLOAD QUALITY" FontSize="13" FontWeight="Bold" Foreground="#4EDEA3"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbQuality" Background="#0C1310" Foreground="#E0E0E0" BorderBrush="#2AFFFFFF" BorderThickness="1" SelectionChanged="CmbQuality_SelectionChanged">
                                    <ComboBoxItem Content="Highest"/>
                                    <ComboBoxItem Content="1080p"/>
                                    <ComboBoxItem Content="720p"/>
                                    <ComboBoxItem Content="480p"/>
                                    <ComboBoxItem Content="360p"/>
                                    <ComboBoxItem Content="Lowest"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <ui:SymbolIcon Symbol="Filter24" FontSize="20" Foreground="#4EDEA3" Margin="0,0,12,0"/>
                                    <TextBlock Text="DOWNLOAD MODE" FontSize="13" FontWeight="Bold" Foreground="#4EDEA3"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbMode" Background="#0C1310" Foreground="#E0E0E0" BorderBrush="#2AFFFFFF" BorderThickness="1" SelectionChanged="CmbMode_SelectionChanged">
                                    <ComboBoxItem Content="Download DRM-Free only"/>
                                    <ComboBoxItem Content="Download DRM Protected only"/>
                                    <ComboBoxItem Content="Download All Videos (Recommended)"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <ui:SymbolIcon Symbol="Translate24" FontSize="20" Foreground="#4EDEA3" Margin="0,0,12,0"/>
                                    <TextBlock Text="ARABIC TRANSLATION" FontSize="13" FontWeight="Bold" Foreground="#4EDEA3"/>
                                </StackPanel>

                                <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto Translate to Arabic" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                            <TextBlock Text="TRANSLATE SUBTITLES AUTOMATICALLY" FontSize="10" Foreground="#9DB0A6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="chkTranslate" Grid.Column="1" VerticalAlignment="Center" Checked="ChkTranslate_CheckedChanged" Unchecked="ChkTranslate_CheckedChanged"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="pnlTranslateMethod" Visibility="Collapsed">
                                    <TextBlock Text="TRANSLATION METHOD" FontSize="11" FontWeight="Bold" Foreground="#9DB0A6" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cmbTranslateMethod" Background="#0C1310" Foreground="#E0E0E0" BorderBrush="#2AFFFFFF" BorderThickness="1" SelectionChanged="CmbTranslateMethod_SelectionChanged">
                                        <ComboBoxItem Content="Local Model (HPLT/MarianMT)"/>
                                        <ComboBoxItem Content="Online API (DeepL/Google)"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <ui:SymbolIcon Symbol="Options24" FontSize="20" Foreground="#4EDEA3" Margin="0,0,12,0"/>
                                    <TextBlock Text="SYSTEM TOGGLES" FontSize="13" FontWeight="Bold" Foreground="#4EDEA3"/>
                                </StackPanel>

                                <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Download Subtitles" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                                <TextBlock Text="SRT, VTT MULTI-LANGUAGE" FontSize="10" Foreground="#9DB0A6" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch x:Name="chkSubs" Grid.Column="1" VerticalAlignment="Center" Checked="ChkSubs_CheckedChanged" Unchecked="ChkSubs_CheckedChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Download Attachments" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                            <TextBlock Text="PDFS, ASSETS, SOURCE CODE" FontSize="10" Foreground="#9DB0A6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="chkAtts" Grid.Column="1" VerticalAlignment="Center" Checked="ChkAtts_CheckedChanged" Unchecked="ChkAtts_CheckedChanged"/>
                                    </Grid>
                                </Border>

                                <Border Background="#1A2D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Download Attachments Only" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                            <TextBlock Text="ATTACHMENTS ONLY (????? ???????? ???)" FontSize="10" Foreground="#9DB0A6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="chkAttsOnly" Grid.Column="1" VerticalAlignment="Center" Checked="ChkAttsOnly_CheckedChanged" Unchecked="ChkAttsOnly_CheckedChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="btnSave" Content="SAVE CHANGES" Click="BtnSave_Click" Padding="32,16" FontSize="12" Background="#4EDEA3" Foreground="#0A1410" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>