<Page x:Class="UdemyKickerWPF.Views.LoggerView"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

      Title="LoggerView">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

            <Button>

                <Button.ContentTemplate>

                    <DataTemplate>

                        <StackPanel Orientation="Horizontal">

                            <ui:SymbolIcon Symbol="Delete24" Margin="0,0,8,0"/>

                            <TextBlock Text="Clear"/>

                        </StackPanel>

                    </DataTemplate>

                </Button.ContentTemplate>

            </Button>

            <Button Content="Export" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#bbcabf" Padding="16,8" Click="BtnSave_Click">

                <Button.ContentTemplate>

                    <DataTemplate>

                        <StackPanel Orientation="Horizontal">

                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0"/>

                            <TextBlock Text="{Binding}"/>

                        </StackPanel>

                    </DataTemplate>

                </Button.ContentTemplate>

            </Button>

        </StackPanel>

        <Border Grid.Row="1" Background="#050505" BorderBrush="#3c4a42" BorderThickness="1" CornerRadius="12" Padding="16">

            <TextBox x:Name="txtLogs" Background="Transparent" Foreground="#4edea3" BorderThickness="0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>

        </Border>

    </Grid>

</Page>
